{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run db:migrate && npm run validate:cron-safety && npx next build",
  "crons": [
    { "path": "/api/cron/bills/us", "schedule": "0 3 * * *" },
    { "path": "/api/cron/bills/uk", "schedule": "30 3 * * *" },
    { "path": "/api/cron/bills/ca", "schedule": "0 4 * * *" },
    { "path": "/api/cron/bills/br", "schedule": "30 4 * * *" },
    { "path": "/api/cron/bills/de", "schedule": "0 5 * * *" },
    { "path": "/api/cron/bills/fr", "schedule": "30 5 * * *" },
    {
      "path": "/api/cron/factbook/sync-wikidata",
      "schedule": "0 6 1 1,4,7,10 *"
    },
    {
      "path": "/api/cron/factbook/sync-officeholders",
      "schedule": "0 2 8 * *"
    },
    { "path": "/api/cron/factbook/sync-cia-cabinets", "schedule": "0 1 * * *" },
    { "path": "/api/cron/factbook/refresh-cache", "schedule": "30 6 * * *" },
    {
