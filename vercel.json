      "schedule": "0 7 15 7 *"
    },
    { "path": "/api/cron/factbook/sync-wdi", "schedule": "0 8 2 1,4,7,10 *" },
    { "path": "/api/cron/factbook/sync-imf-weo", "schedule": "0 9 5 4,10 *" },
    {
      "path": "/api/cron/factbook/sync-un-data",
      "schedule": "0 11 3 1,4,7,10 *"
    },
    {
      "path": "/api/cron/factbook/sync-who-gho",
      "schedule": "0 10 2 1,4,7,10 *"
    },
    {
      "path": "/api/cron/factbook/sync-unesco-uis",
      "schedule": "0 12 4 1,4,7,10 *"
    },
    {
      "path": "/api/cron/factbook/sync-undp-hdi",
      "schedule": "0 13 6 1,4,7,10 *"
    },
    {
      "path": "/api/cron/factbook/sync-oecd-stat",
      "schedule": "0 14 7 1,4,7,10 *"
    },
    {
      "path": "/api/cron/factbook/sync-fao-faostat",
      "schedule": "0 15 8 1,4,7,10 *"
