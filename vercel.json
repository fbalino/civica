    { "path": "/api/cron/factbook/sync-ilo-ilostat", "schedule": "0 9 5 11 *" },
    {
      "path": "/api/cron/factbook/sync-eurostat",
      "schedule": "0 16 9 1,4,7,10 *"
    },
    {
      "path": "/api/cron/factbook/sync-wto-stats",
      "schedule": "0 9 25 1,4,7,10 *"
    },
    { "path": "/api/cron/factbook/sync-insee-fr", "schedule": "0 4 1 * *" },
    {
      "path": "/api/cron/factbook/sync-us-census",
      "schedule": "0 18 11 1,4,7,10 *"
    },
    {
      "path": "/api/cron/factbook/sync-ons-uk",
      "schedule": "0 19 11 1,4,7,10 *"
    },
    {
      "path": "/api/cron/factbook/sync-ibge-br",
      "schedule": "0 22 11 1,4,7,10 *"
    },
    {
      "path": "/api/cron/factbook/sync-statcan-ca",
      "schedule": "0 21 11 1,4,7,10 *"
    },
    {
      "path": "/api/cron/factbook/sync-stats-sa",
      "schedule": "0 23 11 1,4,7,10 *"
    },
    {
      "path": "/api/cron/factbook/auto-resolve-disputes",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/factbook/snapshot-vintage",
      "schedule": "0 4 15 1,4,7,10 *"
    },
    {
      "path": "/api/cron/factbook/verify-reconciliation",
      "schedule": "45 3 * * *"
    },

    { "path": "/api/cron/pulse/v2/ingest", "schedule": "0 8 * * *" },
    { "path": "/api/cron/pulse/v2/cluster", "schedule": "20 8 * * *" },
    { "path": "/api/cron/pulse/v2/classify", "schedule": "40 8 * * *" },
    { "path": "/api/cron/pulse/v2/score", "schedule": "0 9 * * *" },
    { "path": "/api/cron/pulse/v2/review-sla", "schedule": "10 */6 * * *" },
    {
      "path": "/api/cron/operations/error-alerts",
      "schedule": "50 23 * * *"
    },
    {
      "path": "/api/cron/operations/pipeline-alerts",
      "schedule": "55 23 * * *"
    }
  ]
