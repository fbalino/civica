# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local artifacts from diagnostic runs / playwright
/output/
/test-results/
/.firecrawl/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Claude Code per-checkout state (worktrees, plans). Keep launch.json
# committed since it documents the dev server, but ignore everything
# under worktrees/ which is just transient agent isolation copies.
.claude/worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# python (Phase 5.3 PCA analysis lives in /analysis)
**/.venv/
**/__pycache__/
**/*.pyc
