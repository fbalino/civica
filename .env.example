# The machine-readable per-context contract for these variables is
# src/lib/env/contract.ts (PLT-006); npm run validate:env -- --context=<ctx>.
# Required — Neon Postgres connection string
# Obtain from https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required in production only when Vercel Protected Source Maps has been
# enabled for the project. Set exactly `true` in Vercel after enabling that
# setting; it makes Next generate browser maps which Vercel gates to project
# members. Never set this on an unprotected deployment.
VERCEL_PROTECTED_SOURCEMAPS=

# Optional — override the frozen 2024-Q4 Civica Index source artifacts used by
# the canonical ingestion and read-only reproduction audit. Leave unset for the
# checked official publisher URLs in `production-source-adapters.ts`.
# CI_DATASET_YEAR must match an available edition/sheet in every override.
CI_DATASET_YEAR=
# Required only for release writes. First stage the checked header, then use
# the same exact ID for ingestion, calculation, verification, and publication.
CI_TARGET_RELEASE_ID=
# Required only when an Atlas writer appends release-to-release public history.
# Pass the same named Atlas release through every participating writer. This is
# not a deployment ID and must not be synthesized from the current time.
CIVICA_ATLAS_RELEASE_ID=
VDEM_CY_CORE_ZIP_URL=
WGI_DATASET_XLSX_URL=
FREEDOM_HOUSE_FIW_XLSX_URL=
TRANSPARENCY_CPI_XLSX_URL=

# Anthropic API keys — split per workflow for spend attribution.
# Never reuse these keys across scopes or introduce a generic Anthropic key.
# `data/MODEL-OPERATIONS.md` names the required workspace/project spend caps,
# alert thresholds, local request ceilings, and version-change procedure.
# Obtain each key from the matching Civica provider workspace; do not put a
# provider billing/admin/analytics credential in this runtime environment.
#
# Used by /api/chat (Ask Civica chat assistant). claude-sonnet-4-6.
ANTHROPIC_API_KEY_CHAT=
#
# Used by the Anthropic ensemble voter, adversarial verifier, and separate
# subject-country attribution pass. The diagnostic backtest also uses it when
# configured for Anthropic.
ANTHROPIC_API_KEY_PULSE_CLASSIFIER=
#
# Used by the Pulse v2 review-queue summariser (one Haiku call per event
# for the admin reviewer surface). claude-haiku-4-5.
ANTHROPIC_API_KEY_PULSE_SUMMARIZE=
#
# Used by the bills summariser (one-sentence plain-English explainers,
# one Haiku call per chunk of 20 bills). claude-haiku-4-5.
ANTHROPIC_API_KEY_BILLS_SUMMARIZE=
#
# Used by factbook reconciliation — Stats SA PDF extraction
# (src/lib/factbook/reconcile/sync-stats-sa.ts). Quarterly cron.
# claude-haiku-4-5.
ANTHROPIC_API_KEY_RECONCILIATION=

# ─────────────────────────────────────────────────────────────────────
# Pulse classifier — CROSS-MODEL ENSEMBLE (owner decision 2026-07-05)
# plan/pulse-ensemble-classifier-implementation-2026-07-05.md
#
# The published Pulse methodology is a two-pass classify→verify design.
# The classify pass now runs a THREE-MODEL ENSEMBLE — one classify call
# each on different vendors to diversify error sources. This does not establish
# statistical independence. The three calls run in parallel;
# one engine erroring can degrade to the survivors. Successful provider runs
# are stored; the failed provider and a separate degradation flag are not yet
# persisted. Category is a
# strict majority vote (3/3 → "all"; 2/3 → "two_of_three"; no majority →
# "none" → human review). Severe-negative, catastrophic-negative, and
# high-positive classifications also require review. A verifier objection
# (low confidence, revised/rejected verdict, any negative axis, or a
# failed/unavailable call) requires review only when the majority is weak or
# degraded.
#
# FIRECRAWL_API_KEY — optional. Retrieval fallback for publishers that block
# direct ingestion at their edge. Setting it does NOT enable the fallback for
# anyone: Civica does not route around a publisher's block without permission,
# so the fallback runs only for hosts whose recorded state is `granted` in
# src/lib/pulse/v2/publisher-fallback-permission.ts. No publisher grants it
# today. Amnesty International returns HTTP 403 for its whole domain and is
# registered as `not_requested`, so the amnesty connector fails honestly every
# run until an allowlisting request is granted and recorded.
# Where permission does exist, the fallback fetches the SAME public URL through
# Firecrawl and hands the identical bytes to the normal parser — provenance,
# rights record, and licence handling are unchanged. It fires ONLY on a
# 401/403/429 publisher block, never on a timeout or 5xx, so an ordinary bad
# day costs no credits.
FIRECRAWL_API_KEY=
#
# PULSE_CLASSIFY_TRANSPORT — set to "subscription-cli" ONLY on the owner's
# Mac (the daily launchd runner sets it). Selects the pulse-v2.16-beta
# subscription runtime: the four owner-approved CLI voters (Codex
# gpt-5.6-terra, Claude claude-sonnet-5, Kimi kimi-k3, Grok grok-4.5) run
# headlessly at $0 marginal cost, verify + subject attribution run on the
# Claude CLI, and every classification queues for human review (PUL-036).
# NEVER set on Vercel: the scheduled classify route hard-locks against any
# paid HTTP transport regardless of keys
# (plan/pulse-subscription-runtime-resolution-v1.md, owner authority
# 2026-08-17). When set, PULSE_CLASSIFY_ENSEMBLE/PULSE_ENSEMBLE_VERIFY are
# ignored — the panel is a closed set.
PULSE_CLASSIFY_TRANSPORT=
#
# PULSE_CLASSIFY_ENSEMBLE — comma list of provider:model pairs.
#   Default (leave UNSET to use it), three vendors used to diversify errors:
#     deepseek:deepseek-v4-flash,glm:glm-4.7,anthropic:claude-haiku-4-5
#   (GLM defaults to the flagship glm-4.7: the cheap glm-4.7-flashx tier
#   measured 29–74s/call in the 2026-07-05 smoke test — frequently past the
#   60s timeout — so it is not the default; select it here if its latency
#   recovers.)
#   Naming exactly ONE pair falls back to single-engine classify→verify
#   (the prior behavior — no consensus, no extra calls), e.g.:
#     PULSE_CLASSIFY_ENSEMBLE=deepseek:deepseek-v4-flash
#   A bare provider uses that provider's default model (glm → glm-4.7).
PULSE_CLASSIFY_ENSEMBLE=
#
# PULSE_ENSEMBLE_VERIFY — the single provider:model for the adversarial
# verify pass. Default (unset): anthropic:claude-haiku-4-5 (cheap,
# same-vendor as the prompts). The verify pass runs on an "all" consensus
# (adversarial check) and on "two_of_three". A verifier objection (low
# confidence, revised/rejected verdict, any negative axis, or a
# failed/unavailable call) routes to review only when that majority is weak or
# degraded; verification is skipped
# on a deadlock because the event already requires review.
PULSE_ENSEMBLE_VERIFY=
#
# Providers: anthropic | deepseek | glm (alias: zhipu) | openai.
# Model ids + prices verified July 2026:
#   deepseek-v4-flash  $0.14 in / $0.28 out per MTok   (best cheap general)
#   deepseek-v4-pro    $0.435 in / $0.87 out per MTok
#     NOTE: the old deepseek-chat / deepseek-reasoner ids deprecate
#     2026-07-24 — use the v4-* ids.
#   glm-4.7            $0.60 in / $2.20 out per MTok    (flagship)
#   glm-4.7-flashx     $0.07 in / $0.40 out per MTok    (cheap fast tier;
#                      not the default because measured latency was unstable)
#   glm-5.2            $1.40 in / $4.40 out per MTok    (newer flagship)
#   claude-haiku-4-5   $1.00 in / $5.00 out per MTok
#   gpt-4.1-mini       $0.40 in / $1.60 out per MTok    (optional 4th voter)
#
# Single-engine verification overrides. To run one classify engine, name one
# provider:model pair in PULSE_CLASSIFY_ENSEMBLE. Providers as above.
#   PULSE_VERIFY_PROVIDER=anthropic
#   PULSE_VERIFY_MODEL=claude-haiku-4-5
PULSE_VERIFY_PROVIDER=
PULSE_VERIFY_MODEL=

# DeepSeek API key — OpenAI-compatible endpoint https://api.deepseek.com.
# Obtain at https://platform.deepseek.com/ → API keys. Required when any
# Pulse pass uses provider=deepseek (the default). Until this is set, the
# Pulse classify cron no-ops with a logged notice (safe to deploy first).
DEEPSEEK_API_KEY=

# GLM / Zhipu API key — OpenAI-compatible endpoint
# https://api.z.ai/api/paas/v4. Obtain at https://z.ai/ (or
# https://bigmodel.cn/ for the mainland Zhipu console) → API keys.
# Required only when a Pulse pass uses provider=glm.
GLM_API_KEY=

# OpenAI API key — https://api.openai.com/v1. Obtain at
# https://platform.openai.com/ → API keys. Wired as an OPTIONAL FOURTH
# ensemble voter (documented model gpt-4.1-mini). It stays INACTIVE until
# BOTH this key is set AND PULSE_CLASSIFY_ENSEMBLE lists an `openai:...`
# pair. Leave unset for the default three-vendor ensemble.
OPENAI_API_KEY=

# Optional — Pulse diagnostic smoke-test engine override. This single-engine
# harness is not the production ensemble and is not a representative quality
# gate. Set these only for deliberate regression diagnostics.
#   PULSE_BACKTEST_PROVIDER=anthropic|deepseek|glm
#   PULSE_BACKTEST_MODEL=<model id>
PULSE_BACKTEST_PROVIDER=
PULSE_BACKTEST_MODEL=

# Optional — Pulse GDELT ingest width. "standard" (default) uses the base
# governance term set and a 24h window. "wide" adds a conservative set of
# governance-adjacent terms and doubles the look-back window (GDELT caps
# records at 250/request, so this widens recall, not a firehose). Every
# extra ~1,000 events that reach the paid classify path costs ≈ $0.59 in
# classify+verify tokens at DeepSeek V4-Flash prices. Leave unset for
# standard.
PULSE_GDELT_SCOPE=

# Optional — GDELT query mode. "themes" (default) filters on GDELT's GKG
# themes (theme:ARREST, theme:PROTEST, …), which its event-extraction engine
# assigns per article — far more precise than keyword matching, so celebrity
# and sports fluff never enters the pipeline. "keywords" reverts to the legacy
# plain-keyword OR-list. Leave unset for themes.
PULSE_GDELT_QUERY_MODE=
# Optional — extra domains to drop from GDELT results (comma-separated,
# matched as a domain suffix). Appended to the built-in celebrity/aggregator
# blocklist. Example: PULSE_GDELT_DOMAIN_BLOCKLIST=example-tabloid.com,foo.net
PULSE_GDELT_DOMAIN_BLOCKLIST=

# Optional — GDELT article-body enrichment. GDELT returns only a headline +
# URL, so the connector fetches each article and extracts readable text to
# give the classifier real context (specialist feeds already carry body).
#   PULSE_ARTICLE_FETCH           on|off  (default on) — set "off" to disable
#     the fetch entirely and fall back to headline + outlet-domain only
#     (use if a cron run is too slow).
#   PULSE_ARTICLE_FETCH_CONCURRENCY  parallel article fetches (default 5).
#   PULSE_ARTICLE_FETCH_TIMEOUT_MS   per-request fetch timeout (default 12000).
# Enrichment is best-effort: paywalled / 403 / thin pages keep the domain
# fallback, and a failed fetch never fails the ingest.
PULSE_ARTICLE_FETCH=
PULSE_ARTICLE_FETCH_CONCURRENCY=
PULSE_ARTICLE_FETCH_TIMEOUT_MS=

# ─────────────────────────────────────────────────────────────────────
# Admin login — the /admin/* back office (Pulse review, data disputes,
# advisory applications, messages) is gated by a single owner account:
# a username + password. All three vars below MUST be set or the admin
# routes fail closed (sign-in returns 500 / API routes return 401).
#
# ADMIN_USERNAME — the login username (plaintext).
ADMIN_USERNAME=
#
# ADMIN_PASSWORD_HASH — a salted scrypt hash of the password. The
# plaintext is never stored. Generate the value with:
#     npm run admin:set-password
# (type the password at the hidden prompt, or pipe it in) and paste the
# printed `scrypt$...` string here.
ADMIN_PASSWORD_HASH=
#
# ADMIN_SESSION_SECRET — the HMAC key that signs the admin session
# cookie. Keep it distinct from the password hash; rotating it signs
# every operator out. Generate: `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# RATE_LIMIT_KEY_SECRET — independent HMAC key used to obscure validated
# client addresses before distributed rate-limit counters are stored. Required
# in production. Never reuse ADMIN_SESSION_SECRET or a provider credential.
# Generate: `openssl rand -hex 32`
RATE_LIMIT_KEY_SECRET=

# Separate HMAC key for narrow, role-bearing independent-coder sessions.
# Do not reuse ADMIN_SESSION_SECRET: coding participants cannot access owner routes.
PULSE_CODING_SESSION_SECRET=
#
# ADMIN_DISPLAY_NAME — optional. The reviewer name stamped on audit-log
# rows. Defaults to ADMIN_USERNAME when unset.
ADMIN_DISPLAY_NAME=

# Optional — "Sign in with Google" as a second door into the SAME admin
# session (the password login above still works unchanged). All three vars
# below must be set together or the Google option stays hidden on
# /admin/sign-in. Create the OAuth client at console.cloud.google.com
# (Credentials → Create Credentials → OAuth client ID → Web application)
# with authorized redirect URIs:
#   http://localhost:3000/api/admin/google/callback
#   https://civicaatlas.org/api/admin/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# ADMIN_GOOGLE_EMAIL — the ONLY Google account allowed to sign in this way
# (exact match, case-insensitive). Any other Google account is rejected.
ADMIN_GOOGLE_EMAIL=

# Required for scheduled sync/Pulse updates — bearer token Vercel Cron
# sends on each scheduled hit to any /api/cron/* route (bills, factbook
# syncs, Pulse). Also set the same value as the CRON_SECRET environment
# variable in the Vercel project settings.
# Generate: `openssl rand -hex 32`
CRON_SECRET=

# Optional — Congress.gov API key for US legislative data
# Defaults to "DEMO_KEY" (rate-limited) when not set
# Obtain from https://api.congress.gov/sign-up/
CONGRESS_API_KEY=DEMO_KEY

# Optional fail-closed suspension flags for Constitute CC BY-NC text display.
# Set either to "true" before any fee-bearing or commercial deployment;
# constitution search and stable passage excerpts will return 503.
CIVICA_COMMERCIAL_DEPLOYMENT=false
CIVICA_FEE_BEARING_ACCESS=false

# Optional — Bundestag DIP (Dokumentations- und Informationssystem)
# API key for German legislative data. Falls back to a public/anonymous
# key (rate-limited) if unset; sufficient for the daily 100-row sync.
# Register for higher quota at https://dip.bundestag.de/über-dip/hilfe/api
BUNDESTAG_API_KEY=

# Optional — Mapbox PUBLIC token (starts with "pk."). Enables the on-demand
# "Explore in 3D" globe/3D view in the country-page Map Explorer. The default
# 2D map is free (MapLibre + OpenFreeMap) and needs no token. Get one at
# https://account.mapbox.com — and for production, restrict it by URL to
# civicaatlas.org so it can't be reused from the page source.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional — self-hosted Protomaps PMTiles basemap URL for the default 2D
# country map. When set, MapLibre reads this owned .pmtiles archive directly
# over HTTP range requests (no tile server, no meter) and styles it to the
# Civica palette via @protomaps/basemaps. Glyph font PBFs must be hosted
# alongside it at <same folder>/fonts/{fontstack}/{range}.pbf. When UNSET, the
# map falls back to free, keyless OpenFreeMap. Hosted on Vercel Blob today; a
# future move to Cloudflare R2 is a URL swap. See plan/self-hosted-tiles-v1.md.
NEXT_PUBLIC_BASEMAP_PMTILES_URL=

# Optional — PostHog PUBLIC project key (starts with "phc."). Enables the
# consent-gated product analytics described on /privacy#analytics. When UNSET,
# no analytics code loads, the consent banner never appears, and the site
# behaves exactly as it did before analytics existed. The key is public by
# design (it is visible in the page source and can only write events), so
# restrict the PostHog project to civicaatlas.org in the project settings.
NEXT_PUBLIC_POSTHOG_KEY=

# Optional — PostHog ingestion host. Defaults to the US cloud
# (https://us.i.posthog.com). Set to https://eu.i.posthog.com for an EU-region
# project, or to a reverse-proxy origin. Any change here must be reflected in
# the CSP script-src/connect-src allowlist in next.config.ts.
NEXT_PUBLIC_POSTHOG_HOST=
