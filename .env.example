# Required — Neon Postgres connection string
# Obtain from https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Anthropic API keys — split per workflow for spend attribution.
# Each key bills as a separate line item in the Anthropic Console under
# the Civica workspace, so "group by API key" shows which workflow is
# driving cost. Obtain at https://console.anthropic.com/ → Civica
# workspace → API Keys.
#
# Used by /api/chat (Ask Civica chat assistant). claude-sonnet-4-6.
ANTHROPIC_API_KEY_CHAT=
#
# Used ONLY when the Pulse classify/verify/backtest engine is Anthropic
# (see PULSE_CLASSIFY_PROVIDER below). The production classify path
# defaults to DeepSeek as of 2026-07-05; the backtest harness still
# defaults to Anthropic (the validated quality floor). claude-sonnet-4-6.
ANTHROPIC_API_KEY_PULSE_CLASSIFIER=
#
# Used by the Pulse v2 review-queue summariser (one Haiku call per event
# for the admin reviewer surface). claude-haiku-4-5.
ANTHROPIC_API_KEY_PULSE_SUMMARIZE=
#
# Used by the bills summariser (one-sentence plain-English explainers,
# one Haiku call per chunk of 20 bills). claude-haiku-4-5.
ANTHROPIC_API_KEY_BILLS_SUMMARIZE=
#
# Used by factbook reconciliation — Stats SA PDF extraction
# (src/lib/factbook/reconcile/sync-stats-sa.ts). Quarterly cron.
# claude-haiku-4-5.
ANTHROPIC_API_KEY_RECONCILIATION=

# ─────────────────────────────────────────────────────────────────────
# Pulse classifier provider (owner decision 2026-07-05)
# plan/pulse-classifier-cost-resolution-v1.md
#
# The published Pulse methodology is a two-pass classify→verify design.
# The ENGINE running each pass is env-driven and defaults to DeepSeek —
# far cheaper than Anthropic — so the daily Pulse cron can run fully
# automated. Prompts, parse contracts, confidence→agreement mapping, and
# the human-review gate are UNCHANGED; only the model behind each pass
# moves. Providers: anthropic | deepseek | glm (alias: zhipu).
#
# Defaults (leave unset to use them): both passes on DeepSeek's best
# current general model, deepseek-v4-flash.
#   PULSE_CLASSIFY_PROVIDER=deepseek
#   PULSE_CLASSIFY_MODEL=deepseek-v4-flash
#   PULSE_VERIFY_PROVIDER=deepseek
#   PULSE_VERIFY_MODEL=deepseek-v4-flash
#
# GLM (Zhipu / Z.ai) alternative — set all four:
#   PULSE_CLASSIFY_PROVIDER=glm
#   PULSE_CLASSIFY_MODEL=glm-4.7        # flagship general ($0.60/$2.20 per MTok)
#   PULSE_VERIFY_PROVIDER=glm
#   PULSE_VERIFY_MODEL=glm-4.7
#   (cheaper GLM fast tier: glm-4.7-flashx, $0.07/$0.40 per MTok)
#
# Anthropic (fallback / like-for-like with the shipped pipeline):
#   PULSE_CLASSIFY_PROVIDER=anthropic
#   PULSE_CLASSIFY_MODEL=claude-sonnet-4-6   (or claude-haiku-4-5 to save)
#
# Model ids + prices verified July 2026 (research doc §3):
#   deepseek-v4-flash  $0.14 in / $0.28 out per MTok   (best cheap general)
#   deepseek-v4-pro    $0.435 in / $0.87 out per MTok
#     NOTE: the old deepseek-chat / deepseek-reasoner ids deprecate
#     2026-07-24 — use the v4-* ids.
#   glm-4.7            $0.60 in / $2.20 out per MTok    (flagship)
#   glm-4.7-flashx     $0.07 in / $0.40 out per MTok    (cheap fast tier)
#   glm-5.2            $1.40 in / $4.40 out per MTok    (newer flagship)
#
PULSE_CLASSIFY_PROVIDER=
PULSE_CLASSIFY_MODEL=
PULSE_VERIFY_PROVIDER=
PULSE_VERIFY_MODEL=

# DeepSeek API key — OpenAI-compatible endpoint https://api.deepseek.com.
# Obtain at https://platform.deepseek.com/ → API keys. Required when any
# Pulse pass uses provider=deepseek (the default). Until this is set, the
# Pulse classify cron no-ops with a logged notice (safe to deploy first).
DEEPSEEK_API_KEY=

# GLM / Zhipu API key — OpenAI-compatible endpoint
# https://api.z.ai/api/paas/v4. Obtain at https://z.ai/ (or
# https://bigmodel.cn/ for the mainland Zhipu console) → API keys.
# Required only when a Pulse pass uses provider=glm.
GLM_API_KEY=

# Optional — Pulse backtest engine override. The backtest harness is the
# published quality floor and defaults to Anthropic (NOT the cheap
# production classify default) so a production model swap never silently
# changes what the backtest validates against. Set these only to
# deliberately re-validate a candidate engine's backtest verdicts.
#   PULSE_BACKTEST_PROVIDER=anthropic|deepseek|glm
#   PULSE_BACKTEST_MODEL=<model id>
PULSE_BACKTEST_PROVIDER=
PULSE_BACKTEST_MODEL=

# Optional — Pulse GDELT ingest width. "standard" (default) uses the base
# governance term set and a 24h window. "wide" adds a conservative set of
# governance-adjacent terms and doubles the look-back window (GDELT caps
# records at 250/request, so this widens recall, not a firehose). Every
# extra ~1,000 events that reach the paid classify path costs ≈ $0.59 in
# classify+verify tokens at DeepSeek V4-Flash prices. Leave unset for
# standard.
PULSE_GDELT_SCOPE=

# Optional — bearer token for /api/admin/* routes
# If unset, admin routes respond with HTTP 401.
# Generate a random value: `openssl rand -hex 32`
ADMIN_API_KEY=

# Required for scheduled Pulse updates — bearer token Vercel Cron sends
# on each scheduled hit to /api/cron/pulse/*. Also set the same value as
# the CRON_SECRET environment variable in the Vercel project settings.
# Generate: `openssl rand -hex 32`
CRON_SECRET=

# Optional — Congress.gov API key for US legislative data
# Defaults to "DEMO_KEY" (rate-limited) when not set
# Obtain from https://api.congress.gov/sign-up/
CONGRESS_API_KEY=DEMO_KEY

# Optional — Bundestag DIP (Dokumentations- und Informationssystem)
# API key for German legislative data. Falls back to a public/anonymous
# key (rate-limited) if unset; sufficient for the daily 100-row sync.
# Register for higher quota at https://dip.bundestag.de/über-dip/hilfe/api
BUNDESTAG_API_KEY=

# Optional — Mapbox PUBLIC token (starts with "pk."). Enables the on-demand
# "Explore in 3D" globe/3D view in the country-page Map Explorer. The default
# 2D map is free (MapLibre + OpenFreeMap) and needs no token. Get one at
# https://account.mapbox.com — and for production, restrict it by URL to
# civicaatlas.org so it can't be reused from the page source.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional — self-hosted Protomaps PMTiles basemap URL for the default 2D
# country map. When set, MapLibre reads this owned .pmtiles archive directly
# over HTTP range requests (no tile server, no meter) and styles it to the
# Civica palette via @protomaps/basemaps. Glyph font PBFs must be hosted
# alongside it at <same folder>/fonts/{fontstack}/{range}.pbf. When UNSET, the
# map falls back to free, keyless OpenFreeMap. Hosted on Vercel Blob today; a
# future move to Cloudflare R2 is a URL swap. See plan/self-hosted-tiles-v1.md.
NEXT_PUBLIC_BASEMAP_PMTILES_URL=
